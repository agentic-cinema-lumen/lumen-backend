# ==============================================================================
# Lumen Prediction API — Environment Configuration
# ==============================================================================

# --- Vertex AI (Google Cloud Platform) Configuration ---
# Setting GOOGLE_GENAI_USE_VERTEXAI=true routes all Gemini calls to Google Cloud Vertex AI,
# drawing from your GCP billing credits and giving you enterprise-grade quotas.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Model selection (default: gemini-3.7-flash)
LUMEN_AGENT_MODEL=gemini-3.7-flash

# --- Local Authentication for Vertex AI ---
# For local development: run `gcloud auth application-default login`
# Alternatively, point to a service account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Alternative: Google AI Studio Direct API Key ---
# (Ignored if GOOGLE_GENAI_USE_VERTEXAI=true and GCP credentials are configured)
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Search & Pre-mortem Service Keys ---
# PARALLEL_API_KEY=your_parallel_api_key_here
# LUMEN_API_KEY=shared_secret_between_frontend_and_backend
